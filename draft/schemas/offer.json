{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/moochub/draft/schemas/offer.json",
    "title": "Offer",
    "description": "A commercial offer for an educational program, course, or certification.",
    "type": "object",
    "properties": {
        "type": {
            "const": "Offer",
            "description": "The schema.org type of this object."
        },
        "price": {
            "type": "number",
            "minimum": 0,
            "description": "The price of the offer in the specified currency."
        },
        "priceCurrency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "The ISO 4217 currency code for the price."
        },
        "paymentFrequency": {
            "type": "string",
            "enum": [
                "one-time",
                "weekly",
                "monthly",
                "quarterly",
                "half-yearly",
                "by semester",
                "yearly",
                "other"
            ],
            "description": "The payment frequency used by the MOOChub profile."
        },
        "availabilityStarts": {
            "$ref": "https://w3id.org/moochub/draft/schemas/dateOrDateTime.json"
        },
        "availabilityEnds": {
            "$ref": "https://w3id.org/moochub/draft/schemas/dateOrDateTime.json"
        },
        "url": {
            "type": "string",
            "format": "uri",
            "description": "A booking, checkout, enrollment, or access URL for this offer that differs from the main course URL."
        },
        "category": {
            "type": "string",
            "enum": [
                "course",
                "certificate",
                "complete"
            ],
            "description": "Whether the offer covers the course, certification only, or both."
        }
    },
    "required": [
        "type",
        "price",
        "priceCurrency",
        "category"
    ]
}