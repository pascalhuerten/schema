{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moochub/draft/schemas/instructor.json",
  "title": "Instructor",
  "description": "List of instructors of the course. Also organizations can be given.",
  "type": "array",
  "uniqueItems": true,
  "minItems": 1,
  "items": {
    "anyOf": [
      {
