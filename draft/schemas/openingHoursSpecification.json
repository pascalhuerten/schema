{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/moochub/draft/schemas/openingHoursSpecification.json",
    "title": "Opening hours specification",
    "description": "The opening hours of a location on a particular day or range of days.",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "const": "OpeningHoursSpecification"
        },
        "dayOfWeek": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "https://schema.org/Monday",
                    "https://schema.org/Tuesday",
                    "https://schema.org/Wednesday",
                    "https://schema.org/Thursday",
                    "https://schema.org/Friday",
                    "https://schema.org/Saturday",
                    "https://schema.org/Sunday"
                ]
            }
        },
        "opens": {
            "type": "string",
            "format": "time"
        },
        "closes": {
            "type": "string",
            "format": "time"
        },
        "validFrom": {
            "$ref": "https://w3id.org/moochub/draft/schemas/dateOrDateTime.json"
        },
        "validThrough": {
            "$ref": "https://w3id.org/moochub/draft/schemas/dateOrDateTime.json"
        }
    },
    "required": [
        "type",
        "dayOfWeek",
        "opens",
        "closes"
    ]
}
