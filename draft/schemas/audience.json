{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moochub/draft/schemas/audience.json",
  "title": "Intended audience",
  "description": "The intended audience of the course.",
  "type": "object",
  "properties": {
    "audienceType": {
      "$ref": "https://w3id.org/moochub/draft/schemas/audienceType.json"
    },
    "description": {
      "title": "Description",
      "description": "A natural-language description of the intended audience.",
      "$ref": "https://w3id.org/kim/amb/20231019/schemas/localizedString.json"
    },
    "suggestedAge": {
      "$ref": "https://w3id.org/moochub/draft/schemas/suggestedAge.json"
    }
  },
  "anyOf": [
    {
      "required": [
        "audienceType"
      ]
    },
    {
      "required": [
        "description"
      ]
    },
    {
      "required": [
        "suggestedAge"
      ]
    }
  ]
}