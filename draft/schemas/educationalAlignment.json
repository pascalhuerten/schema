{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/moochub/draft/schemas/educationalAlignment.json",
    "title": "Educational alignment",
    "description": "A schema.org AlignmentObject for an educational subject or learner interest. MOOChub uses the LRMI educationalSubject relationship for supported subject frameworks and a learnerInterest relationship for Holland Code / RIASEC targets. Either a targetUrl or an identifier is required to unambiguously identify the target.",
    "type": "array",
    "minItems": 1,
    "uniqueItems": true,
    "items": {
        "type": "object",
        "properties": {
            "type": {
                "const": "AlignmentObject"
            },
            "alignmentType": {
                "type": "string",
                "enum": [
                    "educationalSubject",
                    "learnerInterest"
                ],
                "description": "The type of relationship between the course and its educational subject or learner-interest target."
            },
            "educationalFramework": {
                "type": "string",
                "enum": [
                    "ISCED-F",
                    "OEFOS",
                    "Destatis-Systematik der Fächergruppen, Studienbereiche und Studienfächer",
                    "Schulfächer",
                    "Holland Code"
                ],
                "description": "The educational framework or classification system that the target belongs to."
            },
            "targetUrl": {
                "type": "string",
                "format": "uri",
                "description": "A URL that identifies the alignment target. This can be a URL to a page describing the subject or interest, or a URL to a controlled vocabulary term."
            },
            "identifier": {
                "type": "string",
                "description": "An identifier for the alignment target, such as a code or ID from the educational framework."
            },
            "targetDescription": {
                "$ref": "https://w3id.org/kim/amb/20231019/schemas/localizedString.json",
                "description": "A description of the educational subject or learner-interest target."
            },
            "targetName": {
                "$ref": "https://w3id.org/kim/amb/20231019/schemas/localizedString.json",
                "description": "The name of the educational subject or learner-interest target."
            }
        },
        "required": [
            "type",
            "alignmentType",
            "educationalFramework",
            "targetName"
        ],
        "anyOf": [
            {
                "required": [
                    "targetUrl"
                ]
            },
            {
                "required": [
                    "identifier"
                ]
            }
        ],
        "allOf": [
            {
                "if": {
                    "properties": {
                        "alignmentType": {
                            "const": "educationalSubject"
                        }
                    }
                },
                "then": {
                    "properties": {
                        "educationalFramework": {
                            "enum": [
                                "ISCED-F",
                                "OEFOS",
                                "Destatis-Systematik der Fächergruppen, Studienbereiche und Studienfächer",
                                "Schulfächer"
                            ]
                        }
                    }
                }
            },
            {
                "if": {
                    "properties": {
                        "alignmentType": {
                            "const": "educationalSubject"
                        },
                        "educationalFramework": {
                            "const": "ISCED-F"
                        }
                    }
                },
                "then": {
                    "properties": {
                        "targetUrl": {
                            "pattern": "^http://data.europa.eu/esco/isced-f/.*$"
                        }
                    }
                }
            },
            {
                "if": {
                    "properties": {
                        "alignmentType": {
                            "const": "educationalSubject"
                        },
                        "educationalFramework": {
                            "const": "Destatis-Systematik der Fächergruppen, Studienbereiche und Studienfächer"
                        }
                    }
                },
                "then": {
                    "properties": {
                        "targetUrl": {
                            "pattern": "^https://w3id.org/kim/hochschulfaechersystematik/.*$"
                        }
                    }
                }
            },
            {
                "if": {
                    "properties": {
                        "alignmentType": {
                            "const": "educationalSubject"
                        },
                        "educationalFramework": {
                            "const": "Schulfächer"
                        }
                    }
                },
                "then": {
                    "properties": {
                        "targetUrl": {
                            "pattern": "^http://w3id.org/kim/schulfaecher/.*$"
                        }
                    }
                }
            },
            {
                "if": {
                    "properties": {
                        "alignmentType": {
                            "const": "educationalSubject"
                        },
                        "educationalFramework": {
                            "const": "OEFOS"
                        }
                    }
                },
                "then": {
                    "properties": {
                        "identifier": {
                            "pattern": "^[0-9]{2,4}$"
                        }
                    }
                }
            },
            {
                "if": {
                    "properties": {
                        "alignmentType": {
                            "const": "learnerInterest"
                        }
                    }
                },
                "then": {
                    "properties": {
                        "educationalFramework": {
                            "const": "Holland Code"
                        },
                        "targetUrl": {
                            "enum": [
                                "https://www.onetcenter.org/rdf/resources/onet/Element/52b9e31f-1b12-11ea-8239-782bcb5df6ac",
                                "https://www.onetcenter.org/rdf/resources/onet/Element/52c0ffb3-1b12-11ea-8239-782bcb5df6ac",
                                "https://www.onetcenter.org/rdf/resources/onet/Element/52c657cb-1b12-11ea-8239-782bcb5df6ac",
                                "https://www.onetcenter.org/rdf/resources/onet/Element/52cc9819-1b12-11ea-8239-782bcb5df6ac",
                                "https://www.onetcenter.org/rdf/resources/onet/Element/52e931a2-1b12-11ea-8239-782bcb5df6ac",
                                "https://www.onetcenter.org/rdf/resources/onet/Element/52efe3fd-1b12-11ea-8239-782bcb5df6ac"
                            ]
                        },
                        "identifier": {
                            "enum": [
                                "R",
                                "I",
                                "A",
                                "S",
                                "E",
                                "C"
                            ]
                        }
                    }
                }
            }
        ]
    }
}