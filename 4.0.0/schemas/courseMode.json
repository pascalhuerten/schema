{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/moochub/4.0.0/schemas/courseMode.json",
    "title": "Course mode",
    "description": "The delivery medium, study mode, or temporal mode of a course instance.",
    "type": "array",
    "minItems": 1,
    "uniqueItems": true,
    "items": {
        "type": "string",
        "enum": [
            "MOOC",
            "online",
            "onsite",
            "blended",
            "synchronous",
            "asynchronous"
        ]
    }
}